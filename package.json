{
  "name": "rac-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rope Access Center (RAC) — Training, Certification & Corporate Services. Bilingual (ID/EN) website with custom admin dashboard on Cloudflare Workers.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply rac-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rac-db --remote",
    "admin:hash": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "wrangler": "4.125.0"
  }
}
