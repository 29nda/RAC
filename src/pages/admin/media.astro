---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { listMedia, MAX_UPLOAD_BYTES } from '../../lib/media';
import { getMedia } from '../../lib/env';

const lang = Astro.cookies.get('rac_admin_lang')?.value === 'en' ? 'en' : 'id';
const T = (id: string, en: string) => (lang === 'en' ? en : id);

const bound = Boolean(getMedia(Astro.locals));
const items = await listMedia(Astro.locals);

const formatSize = (bytes: number) =>
  bytes >= 1024 * 1024
    ? `${(bytes / 1024 / 1024).toFixed(1)} MB`
    : `${Math.max(1, Math.round(bytes / 1024))} KB`;

const isImage = (type: string) => type.startsWith('image/');
---

<AdminLayout title={T('Media', 'Media')} section="media" wide>
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl text-navy-800">{T('Pustaka Media', 'Media Library')}</h1>
      <p class="mt-1.5 text-sm text-steel-400">
        {T(
          'Berkas disimpan di Cloudflare R2 dan disajikan dari domain situs dengan cache satu tahun.',
          'Files are stored in Cloudflare R2 and served from the site’s own domain with a one-year cache.',
        )}
      </p>
    </div>
  </header>

  {!bound && (
    <div class="mt-6 border-l-4 border-amber-500 bg-amber-50 p-4 text-[0.8125rem] leading-relaxed text-amber-900">
      <p class="font-semibold">{T('Bucket R2 belum terhubung.', 'No R2 bucket is bound.')}</p>
      <p class="mt-1.5">
        {T('Jalankan', 'Run')} <code class="bg-amber-100 px-1">npx wrangler r2 bucket create rac-media</code>{' '}
        {T('lalu isi bucket_name pada wrangler.toml.', 'then set bucket_name in wrangler.toml.')}
      </p>
    </div>
  )}

  <!-- Upload -->
  <form id="upload-form" class="card mt-6 p-6">
    <input type="hidden" name="csrf" value="" />
    <input type="hidden" name="action" value="upload" />

    <h2 class="font-display text-sm uppercase tracking-[0.14em] text-navy-800">
      {T('Unggah Berkas', 'Upload a File')}
    </h2>

    <div class="mt-4 grid gap-4 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <label class="mb-2 block text-[0.8125rem] font-semibold text-navy-800" for="file">
          {T('Berkas', 'File')}
        </label>
        <input
          class="w-full border border-steel-200 bg-white px-3 py-2.5 text-sm file:mr-3 file:border-0 file:bg-navy-800 file:px-3 file:py-1.5 file:text-[0.75rem] file:font-semibold file:text-white"
          type="file"
          id="file"
          name="file"
          accept="image/webp,image/jpeg,image/png,image/avif,image/svg+xml,application/pdf"
          required
          disabled={!bound}
        />
        <p class="mt-2 text-[0.75rem] text-steel-400">
          WebP, JPEG, PNG, AVIF, SVG, PDF · {T('maks', 'max')} {Math.round(MAX_UPLOAD_BYTES / 1024 / 1024)} MB
        </p>
      </div>

      <div>
        <label class="mb-2 block text-[0.8125rem] font-semibold text-navy-800" for="alt-id">
          {T('Teks Alternatif (Indonesia)', 'Alt text (Indonesian)')}
        </label>
        <input class="w-full border border-steel-200 px-3 py-2.5 text-sm focus:border-navy-800 focus:outline-none"
          type="text" id="alt-id" name="alt.id" maxlength="300" disabled={!bound} />
      </div>

      <div>
        <label class="mb-2 block text-[0.8125rem] font-semibold text-navy-800" for="alt-en">
          {T('Teks Alternatif (Inggris)', 'Alt text (English)')}
        </label>
        <input class="w-full border border-steel-200 px-3 py-2.5 text-sm focus:border-navy-800 focus:outline-none"
          type="text" id="alt-en" name="alt.en" maxlength="300" disabled={!bound} />
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button type="submit" class="btn btn-primary btn-sm" data-submit disabled={!bound}>
        <Icon name="download" size={15} class="rotate-180" />
        <span data-submit-label>{T('Unggah', 'Upload')}</span>
      </button>
      <p id="upload-message" class="hidden text-[0.8125rem]" role="status" aria-live="polite"></p>
    </div>
  </form>

  <!-- Library -->
  <section class="mt-8">
    <h2 class="font-display text-sm uppercase tracking-[0.14em] text-navy-800">
      {T('Berkas Tersimpan', 'Stored Files')} <span class="text-steel-300">({items.length})</span>
    </h2>

    {items.length === 0 ? (
      <p class="card mt-4 p-8 text-center text-sm text-steel-300">
        {T('Belum ada berkas yang diunggah.', 'No files uploaded yet.')}
      </p>
    ) : (
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {items.map((media) => (
          <li class="card overflow-hidden">
            <div class="flex h-32 items-center justify-center bg-steel-50">
              {isImage(media.contentType) ? (
                <img src={media.url} alt={media.alt ?? ''} class="max-h-32 w-auto object-contain" loading="lazy" />
              ) : (
                <Icon name="clipboard" size={30} class="text-steel-300" />
              )}
            </div>

            <div class="p-4">
              <p class="truncate text-[0.8125rem] font-medium text-navy-800" title={media.key}>
                {media.key.split('/').pop()}
              </p>
              <p class="mt-0.5 text-[0.75rem] text-steel-300">
                {formatSize(media.size)} · {media.uploadedAt.slice(0, 10)}
              </p>

              <div class="mt-3 flex items-center gap-2">
                <button
                  type="button"
                  class="flex-1 border border-steel-200 px-2 py-1.5 text-[0.75rem] text-steel-500 transition-colors hover:border-navy-800 hover:text-navy-800"
                  data-copy={media.url}
                >{T('Salin URL', 'Copy URL')}</button>
                <button
                  type="button"
                  class="border border-steel-200 px-2 py-1.5 text-brand-600 transition-colors hover:border-brand-600 hover:bg-brand-600 hover:text-white"
                  data-delete={media.key}
                  aria-label={T('Hapus', 'Delete')}
                ><Icon name="trash" size={14} /></button>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</AdminLayout>

<script
  nonce={Astro.locals.cspNonce}
  is:inline
  define:vars={{
    uploadingText: T('Mengunggah…', 'Uploading…'),
    uploadText: T('Unggah', 'Upload'),
    copiedText: T('URL disalin.', 'URL copied.'),
    deletedText: T('Berkas dihapus.', 'File deleted.'),
    failText: T('Gagal.', 'Failed.'),
    confirmDelete: T('Hapus berkas ini secara permanen?', 'Delete this file permanently?'),
  }}
>
  (function () {
    var form = document.getElementById('upload-form');
    var message = document.getElementById('upload-message');
    var button = form.querySelector('[data-submit]');
    var buttonLabel = form.querySelector('[data-submit-label]');
    form.elements.csrf.value = window.RAC_ADMIN.csrf;

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      button.disabled = true;
      buttonLabel.textContent = uploadingText;
      message.classList.add('hidden');

      window.RAC_ADMIN.post('/api/admin/media', new FormData(form))
        .then(function (result) {
          if (result.ok && result.data.ok) {
            window.location.reload();
            return;
          }
          message.textContent = result.data.message || failText;
          message.style.color = '#bf0510';
          message.classList.remove('hidden');
        })
        .finally(function () {
          button.disabled = false;
          buttonLabel.textContent = uploadText;
        });
    });

    document.querySelectorAll('[data-copy]').forEach(function (control) {
      control.addEventListener('click', function () {
        var value = control.getAttribute('data-copy');
        var done = function () { window.RAC_ADMIN.toast(copiedText, true); };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(value).then(done, done);
        } else {
          window.prompt('URL', value);
        }
      });
    });

    document.querySelectorAll('[data-delete]').forEach(function (control) {
      control.addEventListener('click', function () {
        if (!window.confirm(confirmDelete)) return;
        window.RAC_ADMIN.post('/api/admin/media', {
          action: 'delete',
          key: control.getAttribute('data-delete'),
        }).then(function (result) {
          if (result.ok && result.data.ok) {
            window.RAC_ADMIN.toast(deletedText, true);
            window.location.reload();
          } else {
            window.RAC_ADMIN.toast((result.data && result.data.message) || failText, false);
          }
        });
      });
    });
  })();
</script>
