---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { COLLECTIONS } from '../../lib/adminSchema';
import { getContent } from '../../lib/content';
import { listEnquiries, listAudit, isDatabaseReady } from '../../lib/db';
import { getDB, getMedia, getCache } from '../../lib/env';
import type { CollectionName } from '../../lib/types';

const lang = Astro.cookies.get('rac_admin_lang')?.value === 'en' ? 'en' : 'id';
const T = (id: string, en: string) => (lang === 'en' ? en : id);

const content = await getContent(Astro.locals);
const enquiries = await listEnquiries(Astro.locals, 8);
const audit = await listAudit(Astro.locals, 8);
const dbReady = await isDatabaseReady(Astro.locals);

const newEnquiries = enquiries.filter((e) => e.status === 'new').length;

const counts = COLLECTIONS.filter((c) => !c.singleton).map((collection) => {
  const source = collection.name === 'pages'
    ? Object.values(content.pages)
    : (content[collection.name as CollectionName] as unknown as unknown[]);
  return { collection, count: Array.isArray(source) ? source.length : 0 };
});

const missing = [
  !getDB(Astro.locals) && 'D1',
  !getCache(Astro.locals) && 'KV',
  !getMedia(Astro.locals) && 'R2',
].filter(Boolean) as string[];
---

<AdminLayout title={T('Ringkasan', 'Overview')} section="overview">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl text-navy-800">{T('Ringkasan', 'Overview')}</h1>
      <p class="mt-1.5 text-sm text-steel-400">
        {T('Kelola seluruh isi situs dari satu tempat.', 'Manage everything the site publishes from one place.')}
      </p>
    </div>

    <button type="button" id="purge-cache" class="btn btn-ghost-dark btn-sm">
      <Icon name="layers" size={15} />
      {T('Bersihkan Cache', 'Purge Cache')}
    </button>
  </header>

  {missing.length > 0 && (
    <div class="mt-6 border-l-4 border-amber-500 bg-amber-50 p-4 text-[0.8125rem] leading-relaxed text-amber-900">
      <p class="font-semibold">
        {T('Sebagian layanan Cloudflare belum terhubung', 'Some Cloudflare services are not bound yet')}
        {' '}({missing.join(', ')}).
      </p>
      <p class="mt-1.5">
        {T(
          'Situs tetap tayang menggunakan konten bawaan dari repositori, tetapi perubahan dari dashboard belum dapat disimpan. Ikuti panduan di SETUP.md untuk membuatnya — seluruhnya tersedia pada paket gratis Cloudflare.',
          'The public site still renders from the repository defaults, but dashboard edits cannot be saved yet. Follow SETUP.md to create them — all of it fits inside Cloudflare’s free tier.',
        )}
      </p>
    </div>
  )}

  {!dbReady && getDB(Astro.locals) && (
    <div class="mt-6 border-l-4 border-amber-500 bg-amber-50 p-4 text-[0.8125rem] leading-relaxed text-amber-900">
      <p class="font-semibold">{T('Migrasi database belum dijalankan.', 'Database migrations have not run yet.')}</p>
      <p class="mt-1.5">
        {T('Jalankan', 'Run')} <code class="bg-amber-100 px-1">npm run db:migrate:remote</code>{' '}
        {T('sebelum menyimpan perubahan.', 'before saving any changes.')}
      </p>
    </div>
  )}

  <!-- Quick stats -->
  <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <a href="/admin/enquiries" class="card card-hover block p-5">
      <div class="flex items-center justify-between">
        <Icon name="mail" size={20} class="text-brand-600" />
        {newEnquiries > 0 && (
          <span class="bg-brand-600 px-2 py-0.5 text-[0.6875rem] font-bold text-white">
            {newEnquiries} {T('baru', 'new')}
          </span>
        )}
      </div>
      <p class="mt-3 font-display text-2xl text-navy-800">{enquiries.length}</p>
      <p class="text-[0.8125rem] text-steel-400">{T('Pesan masuk terbaru', 'Recent enquiries')}</p>
    </a>

    {counts.slice(0, 3).map((entry) => (
      <a href={`/admin/content/${entry.collection.name}`} class="card card-hover block p-5">
        <Icon name={entry.collection.icon as 'layers'} size={20} class="text-brand-600" />
        <p class="mt-3 font-display text-2xl text-navy-800">{entry.count}</p>
        <p class="text-[0.8125rem] text-steel-400">{entry.collection.label[lang]}</p>
      </a>
    ))}
  </div>

  <!-- Collections -->
  <section class="mt-10">
    <h2 class="font-display text-sm uppercase tracking-[0.14em] text-navy-800">
      {T('Semua Koleksi', 'All Collections')}
    </h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {COLLECTIONS.map((collection) => {
        const entry = counts.find((c) => c.collection.name === collection.name);
        return (
          <li>
            <a
              href={collection.singleton ? '/admin/content/settings' : `/admin/content/${collection.name}`}
              class="card card-hover flex items-center gap-3.5 p-4"
            >
              <span class="flex h-10 w-10 flex-none items-center justify-center bg-steel-50 text-brand-600">
                <Icon name={collection.icon as 'layers'} size={19} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold text-navy-800">
                  {collection.label[lang]}
                </span>
                <span class="block text-[0.75rem] text-steel-300">
                  {collection.singleton
                    ? T('Satu berkas pengaturan', 'A single settings record')
                    : `${entry?.count ?? 0} ${T('item', 'items')}`}
                </span>
              </span>
              <Icon name="chevron-right" size={16} class="flex-none text-steel-300" />
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- Recent activity -->
  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    <section>
      <h2 class="font-display text-sm uppercase tracking-[0.14em] text-navy-800">
        {T('Pesan Terbaru', 'Latest Enquiries')}
      </h2>
      <div class="card mt-4">
        {enquiries.length === 0 ? (
          <p class="p-5 text-[0.8125rem] text-steel-300">
            {T('Belum ada pesan masuk.', 'No enquiries yet.')}
          </p>
        ) : (
          <ul class="divide-y divide-steel-100">
            {enquiries.map((enquiry) => (
              <li class="flex items-center justify-between gap-3 p-4">
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-navy-800">{enquiry.name}</p>
                  <p class="truncate text-[0.75rem] text-steel-300">
                    {enquiry.subject} · {enquiry.created_at.slice(0, 10)}
                  </p>
                </div>
                <span class="flex-none border border-steel-200 px-2 py-0.5 text-[0.625rem] uppercase tracking-wide text-steel-400">
                  {enquiry.status}
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <section>
      <h2 class="font-display text-sm uppercase tracking-[0.14em] text-navy-800">
        {T('Aktivitas Dashboard', 'Dashboard Activity')}
      </h2>
      <div class="card mt-4">
        {audit.length === 0 ? (
          <p class="p-5 text-[0.8125rem] text-steel-300">
            {T('Belum ada aktivitas tercatat.', 'No activity recorded yet.')}
          </p>
        ) : (
          <ul class="divide-y divide-steel-100">
            {audit.map((row) => (
              <li class="flex items-center justify-between gap-3 p-4">
                <div class="min-w-0">
                  <p class="truncate text-sm text-navy-800">{row.action}</p>
                  <p class="truncate text-[0.75rem] text-steel-300">{row.target ?? '—'}</p>
                </div>
                <time class="flex-none text-[0.75rem] text-steel-300" datetime={row.created_at}>
                  {row.created_at.slice(5, 16)}
                </time>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </div>
</AdminLayout>

<script nonce={Astro.locals.cspNonce} is:inline define:vars={{ okText: T('Cache dibersihkan.', 'Cache purged.'), failText: T('Gagal membersihkan cache.', 'Could not purge the cache.') }}>
  document.getElementById('purge-cache').addEventListener('click', function () {
    window.RAC_ADMIN.post('/api/admin/cache', {}).then(function (result) {
      window.RAC_ADMIN.toast(result.ok ? okText : failText, result.ok);
    });
  });
</script>
