---
import { matchPath, localizedPath } from '../i18n/config';
import { getContent } from '../lib/content';
import { useTranslations, pick } from '../i18n/ui';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';

// Keep the visitor in the language they were browsing, where we can tell.
const locale = Astro.url.pathname.startsWith('/en') ? 'en' : (matchPath(Astro.url.pathname)?.locale ?? 'id');
const content = await getContent(Astro.locals);
const t = useTranslations(locale);
const s = content.settings;

Astro.response.status = 404;

const links = [
  { key: 'training' as const, label: t('nav.training') },
  { key: 'services' as const, label: t('nav.services') },
  { key: 'schedule' as const, label: t('nav.schedule') },
  { key: 'contact' as const, label: t('nav.contact') },
];
---

<SiteLayout
  locale={locale}
  routeKey="home"
  content={content}
  title={`404 — ${t('error.404Title')} · ${s.brandName}`}
  description={t('error.404Body')}
  noindex
>
  <section class="relative overflow-hidden bg-navy-800 text-white">
    <div class="absolute inset-0 grid-noise opacity-60" aria-hidden="true"></div>
    <img
      src="/brand/climber-240.webp"
      width="240"
      height="504"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="pointer-events-none absolute -right-4 bottom-0 hidden h-[85%] w-auto opacity-10 lg:block"
    />

    <div class="container-rac relative py-24 lg:py-32">
      <p class="font-display text-[5rem] font-bold leading-none text-brand-600 lg:text-[8rem]">404</p>
      <h1 class="mt-4 text-3xl lg:text-5xl">{t('error.404Title')}</h1>
      <p class="mt-5 max-w-xl leading-relaxed text-white/70">{t('error.404Body')}</p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href={localizedPath('home', locale)} class="btn btn-primary">
          {t('error.home')}
          <Icon name="arrow-right" size={16} />
        </a>
        {links.map((link) => (
          <a href={localizedPath(link.key, locale)} class="btn btn-ghost-light">{link.label}</a>
        ))}
      </div>

      <p class="mt-10 text-sm text-white/50">{pick(s.tagline, locale)}</p>
    </div>
  </section>
</SiteLayout>
