---
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/config';
import { useTranslations, pick } from '../i18n/ui';
import type { Service } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  service: Service;
  compact?: boolean;
}

const { locale, service, compact = false } = Astro.props;
const t = useTranslations(locale);
const href = localizedPath('services', locale, service.slug);
const icon = (service.icon || 'briefcase') as 'briefcase';
---

<article class="card card-hover reveal relative flex h-full flex-col p-6 lg:p-7">
  <span class="inline-flex h-12 w-12 items-center justify-center bg-surface-alt text-brand-ink">
    <Icon name={icon} size={24} />
  </span>

  <h3 class="mt-5 text-lg leading-snug text-ink">
    <a href={href} class="after:absolute after:inset-0">{pick(service.title, locale)}</a>
  </h3>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{pick(service.summary, locale)}</p>

  {!compact && service.industries[locale]?.length > 0 && (
    <ul class="mt-5 flex flex-wrap gap-1.5">
      {service.industries[locale].slice(0, 3).map((industry) => (
        <li class="border border-line px-2 py-0.5 text-[0.6875rem] text-muted">{industry}</li>
      ))}
    </ul>
  )}

  <p class="mt-6 flex items-center gap-2 font-display text-[0.75rem] font-bold uppercase tracking-[0.1em] text-brand-ink">
    {t('cta.learnMore')}
    <Icon name="arrow-right" size={15} />
  </p>
</article>
