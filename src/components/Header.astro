---
import type { Locale, RouteKey } from '../i18n/config';
import { localizedPath } from '../i18n/config';
import { useTranslations, pick } from '../i18n/ui';
import type { Course, Service, SiteSettings } from '../lib/types';
import { whatsappUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: string;
  settings: SiteSettings;
  courses: Course[];
  services: Service[];
}

const { locale, routeKey, slug, settings, courses, services } = Astro.props;
const t = useTranslations(locale);
const nonce = Astro.locals.cspNonce;

const wa = whatsappUrl(settings, locale);

interface NavItem {
  key: RouteKey;
  label: string;
  children?: Array<{ href: string; label: string; note?: string }>;
}

const nav: NavItem[] = [
  { key: 'home', label: t('nav.home') },
  { key: 'about', label: t('nav.about') },
  {
    key: 'training',
    label: t('nav.training'),
    children: [
      ...courses.slice(0, 6).map((course) => ({
        href: localizedPath('training', locale, course.slug),
        label: pick(course.title, locale),
        note: course.scheme,
      })),
      { href: localizedPath('schedule', locale), label: t('nav.schedule') },
    ],
  },
  { key: 'certification', label: t('nav.certification') },
  {
    key: 'services',
    label: t('nav.services'),
    children: services.slice(0, 6).map((service) => ({
      href: localizedPath('services', locale, service.slug),
      label: pick(service.title, locale),
    })),
  },
  { key: 'blog', label: t('nav.blog') },
  { key: 'contact', label: t('nav.contact') },
];

const isActive = (key: RouteKey) => key === routeKey;
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-navy-800/95 backdrop-blur-md transition-shadow duration-300 border-b border-white/10"
>
  <a href="#main" class="skip-link">{t('meta.skip')}</a>

  <div class="container-rac">
    <div class="flex h-[var(--header-h)] items-center justify-between gap-4">
      <a
        href={localizedPath('home', locale)}
        class="flex-none"
        aria-label={`${settings.brandName} — ${t('nav.home')}`}
      >
        <img
          src="/brand/logo-onDark-240.webp"
          srcset="/brand/logo-onDark-240.webp 240w, /brand/logo-onDark-360.webp 360w"
          sizes="150px"
          width="150"
          height="78"
          alt={`${settings.brandName} logo`}
          class="h-11 w-auto sm:h-12"
          fetchpriority="high"
          decoding="async"
        />
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden items-center xl:flex" aria-label={t('nav.primary')}>
        {nav.map((item) => (
          item.children ? (
            <div class="group relative">
              <a
                href={localizedPath(item.key, locale)}
                class:list={[
                  'flex items-center gap-1.5 whitespace-nowrap px-2.5 py-2 font-display text-[0.8125rem] font-bold uppercase tracking-[0.08em] transition-colors',
                  isActive(item.key) ? 'text-white' : 'text-white/70 hover:text-white',
                ]}
                aria-current={isActive(item.key) ? 'page' : undefined}
                aria-haspopup="true"
              >
                {item.label}
                <Icon name="chevron-down" size={14} class="transition-transform group-hover:rotate-180" />
              </a>
              {isActive(item.key) && <span class="absolute inset-x-2.5 bottom-1 h-0.5 bg-brand-600"></span>}

              <div
                class="invisible absolute left-0 top-full w-[19rem] translate-y-1 border border-navy-100 bg-card opacity-0 shadow-2xl transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
              >
                <ul class="py-2">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm text-muted transition-colors hover:bg-surface-alt hover:text-ink"
                      >
                        <span>{child.label}</span>
                        {child.note && (
                          <span class="flex-none font-display text-[0.625rem] font-bold uppercase tracking-wider text-brand-ink">
                            {child.note}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={localizedPath(item.key, locale)}
              class:list={[
                'relative whitespace-nowrap px-2.5 py-2 font-display text-[0.8125rem] font-bold uppercase tracking-[0.08em] transition-colors',
                isActive(item.key) ? 'text-white' : 'text-white/70 hover:text-white',
              ]}
              aria-current={isActive(item.key) ? 'page' : undefined}
            >
              {item.label}
              {isActive(item.key) && <span class="absolute inset-x-2.5 bottom-1 h-0.5 bg-brand-600"></span>}
            </a>
          )
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <ThemeToggle locale={locale} class="hidden h-9 w-9 sm:inline-flex" />
        <LanguageSwitcher locale={locale} routeKey={routeKey} slug={slug} class="hidden sm:inline-flex" />

        <a href={wa} class="btn btn-primary btn-sm hidden lg:inline-flex" rel="noopener" target="_blank">
          {t('cta.header')}
        </a>

        <button
          type="button"
          id="nav-toggle"
          class="inline-flex h-11 w-11 items-center justify-center text-white xl:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label={t('nav.open')}
        >
          <Icon name="menu" size={26} class="js-open" />
          <Icon name="close" size={26} class="js-close hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile navigation -->
  <div
    id="mobile-nav"
    class="hidden max-h-[calc(100dvh-var(--header-h))] overflow-y-auto overscroll-contain border-t border-white/10 bg-navy-800 xl:hidden"
  >
    <nav class="container-rac py-5" aria-label={t('nav.primary')}>
      <ul class="divide-y divide-white/10">
        {nav.map((item) => (
          <li class="py-1">
            <div class="flex items-center justify-between">
              <a
                href={localizedPath(item.key, locale)}
                class:list={[
                  'flex-1 py-3 font-display text-base font-bold uppercase tracking-[0.06em]',
                  isActive(item.key) ? 'text-brand-ink' : 'text-white',
                ]}
                aria-current={isActive(item.key) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <button
                  type="button"
                  class="js-submenu inline-flex h-11 w-11 items-center justify-center text-white/60"
                  aria-expanded="false"
                  aria-label={item.label}
                >
                  <Icon name="chevron-down" size={20} />
                </button>
              )}
            </div>
            {item.children && (
              <ul class="js-submenu-panel hidden pb-3 pl-3">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block py-2 text-sm text-white/65 hover:text-white">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <div class="mt-6 space-y-3">
        <a href={wa} class="btn btn-whatsapp btn-block" rel="noopener" target="_blank">
          <Icon name="whatsapp" size={18} filled />
          {t('cta.whatsapp')}
        </a>
        <div class="flex items-center gap-3">
          <LanguageSwitcher locale={locale} routeKey={routeKey} slug={slug} class="flex-1 justify-center" />
          <ThemeToggle locale={locale} class="inline-flex h-11 w-11 flex-none" />
        </div>
      </div>
    </nav>
  </div>
</header>

<script nonce={nonce} is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var panel = document.getElementById('mobile-nav');
    var header = document.getElementById('site-header');
    if (!toggle || !panel) return;

    var openIcon = toggle.querySelector('.js-open');
    var closeIcon = toggle.querySelector('.js-close');

    function setOpen(open) {
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      if (openIcon) openIcon.classList.toggle('hidden', open);
      if (closeIcon) closeIcon.classList.toggle('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', function () {
      setOpen(panel.classList.contains('hidden'));
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !panel.classList.contains('hidden')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Collapse the drawer when the viewport grows past the desktop breakpoint,
    // otherwise `overflow: hidden` would stay stuck on the body.
    var wide = window.matchMedia('(min-width: 1280px)');
    wide.addEventListener('change', function (event) {
      if (event.matches) setOpen(false);
    });

    panel.querySelectorAll('.js-submenu').forEach(function (button) {
      button.addEventListener('click', function () {
        var list = button.closest('li');
        var sub = list && list.querySelector('.js-submenu-panel');
        if (!sub) return;
        var open = sub.classList.contains('hidden');
        sub.classList.toggle('hidden', !open);
        button.setAttribute('aria-expanded', String(open));
        button.style.transform = open ? 'rotate(180deg)' : '';
      });
    });

    if (header) {
      var onScroll = function () {
        header.classList.toggle('shadow-xl', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  })();
</script>
