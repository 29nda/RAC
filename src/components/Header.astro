---
import type { Locale, RouteKey } from '../i18n/config';
import { localizedPath } from '../i18n/config';
import { useTranslations, pick } from '../i18n/ui';
import type { Course, Service, SiteSettings } from '../lib/types';
import { whatsappUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: string;
  settings: SiteSettings;
  courses: Course[];
  services: Service[];
}

const { locale, routeKey, slug, settings, courses, services } = Astro.props;
const t = useTranslations(locale);
const nonce = Astro.locals.cspNonce;

const wa = whatsappUrl(settings, locale);

type IconName = 'home' | 'building' | 'graduation-cap' | 'certificate' | 'wrench'
  | 'newspaper' | 'phone' | 'calendar';

interface NavChild {
  href: string;
  label: string;
  icon: IconName;
  note?: string;
}

interface NavItem {
  key: RouteKey;
  label: string;
  icon: IconName;
  children?: NavChild[];
}

const nav: NavItem[] = [
  { key: 'home', label: t('nav.home'), icon: 'home' },
  { key: 'about', label: t('nav.about'), icon: 'building' },
  {
    key: 'training',
    label: t('nav.training'),
    icon: 'graduation-cap',
    children: [
      ...courses.slice(0, 6).map((course) => ({
        href: localizedPath('training', locale, course.slug),
        label: pick(course.title, locale),
        icon: 'graduation-cap' as const,
        note: course.scheme,
      })),
      { href: localizedPath('schedule', locale), label: t('nav.schedule'), icon: 'calendar' as const },
    ],
  },
  { key: 'certification', label: t('nav.certification'), icon: 'certificate' },
  {
    key: 'services',
    label: t('nav.services'),
    icon: 'wrench',
    children: services.slice(0, 6).map((service) => ({
      href: localizedPath('services', locale, service.slug),
      label: pick(service.title, locale),
      icon: 'wrench' as const,
    })),
  },
  { key: 'blog', label: t('nav.blog'), icon: 'newspaper' },
  { key: 'contact', label: t('nav.contact'), icon: 'phone' },
];

const isActive = (key: RouteKey) => key === routeKey;
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-navy-800/95 backdrop-blur-md transition-shadow duration-300 border-b border-white/10"
>
  <a href="#main" class="skip-link">{t('meta.skip')}</a>

  <div class="container-rac">
    <div class="flex h-[var(--header-h)] items-center justify-between gap-3 sm:gap-4">
      <a
        href={localizedPath('home', locale)}
        class="flex-none"
        aria-label={`${settings.brandName} — ${t('nav.home')}`}
      >
        <img
          src="/brand/logo-onDark-240.webp"
          srcset="/brand/logo-onDark-240.webp 240w, /brand/logo-onDark-360.webp 360w"
          sizes="150px"
          width="150"
          height="78"
          alt={`${settings.brandName} logo`}
          class="h-10 w-auto sm:h-12"
          fetchpriority="high"
          decoding="async"
        />
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden items-center xl:flex" aria-label={t('nav.primary')}>
        {nav.map((item) => (
          item.children ? (
            <div class="group relative">
              <a
                href={localizedPath(item.key, locale)}
                class:list={[
                  'flex items-center gap-1.5 whitespace-nowrap px-2.5 py-2 font-display text-[0.8125rem] font-bold uppercase tracking-[0.08em] transition-colors',
                  isActive(item.key) ? 'text-white' : 'text-white/70 hover:text-white',
                ]}
                aria-current={isActive(item.key) ? 'page' : undefined}
                aria-haspopup="true"
              >
                {item.label}
                <Icon name="chevron-down" size={14} class="transition-transform group-hover:rotate-180" />
              </a>
              {isActive(item.key) && <span class="absolute inset-x-2.5 bottom-1 h-0.5 bg-brand-600"></span>}

              <div
                class="invisible absolute left-0 top-full w-[21rem] translate-y-1 border border-line bg-card opacity-0 shadow-2xl transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
              >
                <ul class="py-2">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="group/link flex items-center gap-3 px-4 py-2.5 text-sm text-muted transition-colors hover:bg-surface-alt hover:text-ink"
                      >
                        <Icon
                          name={child.icon}
                          size={17}
                          class="flex-none text-soft transition-colors group-hover/link:text-brand-ink"
                        />
                        <span class="flex-1">{child.label}</span>
                        {child.note && (
                          <span class="flex-none font-display text-[0.625rem] font-bold uppercase tracking-wider text-brand-ink">
                            {child.note}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={localizedPath(item.key, locale)}
              class:list={[
                'relative whitespace-nowrap px-2.5 py-2 font-display text-[0.8125rem] font-bold uppercase tracking-[0.08em] transition-colors',
                isActive(item.key) ? 'text-white' : 'text-white/70 hover:text-white',
              ]}
              aria-current={isActive(item.key) ? 'page' : undefined}
            >
              {item.label}
              {isActive(item.key) && <span class="absolute inset-x-2.5 bottom-1 h-0.5 bg-brand-600"></span>}
            </a>
          )
        ))}
      </nav>

      {/* Pengalih bahasa dan pengalih tema berdampingan di semua lebar layar,
          termasuk ponsel — keduanya adalah setelan tampilan, jadi tempatnya
          memang bersebelahan. */}
      <div class="flex items-center gap-2 sm:gap-3">
        <LanguageSwitcher locale={locale} routeKey={routeKey} slug={slug} class="inline-flex flex-none" />
        <ThemeToggle locale={locale} class="inline-flex h-[26px] w-9 flex-none" />

        <a href={wa} class="btn btn-primary btn-sm hidden lg:inline-flex" rel="noopener" target="_blank">
          {t('cta.header')}
        </a>

        <button
          type="button"
          id="nav-toggle"
          class="-mr-2 inline-flex h-11 w-11 flex-none items-center justify-center text-white xl:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label={t('nav.open')}
        >
          <Icon name="menu" size={26} />
        </button>
      </div>
    </div>
  </div>
</header>

{/* Laci navigasi (off-canvas) — sengaja berada di luar <header>. Header
    memakai backdrop-blur, dan sebuah elemen dengan backdrop-filter menjadi
    containing block bagi keturunannya yang position:fixed, sehingga laci ini
    akan terkurung di dalam bilah header bila diletakkan di dalamnya. */}
<div
  id="mobile-nav"
  class="invisible fixed inset-0 z-[60] xl:hidden"
  aria-hidden="true"
>
  <div
    class="js-nav-backdrop absolute inset-0 bg-navy-950/70 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 motion-reduce:transition-none"
    data-nav-close
  >
  </div>

  <aside
    class="js-nav-panel on-navy absolute inset-y-0 right-0 flex w-[min(21rem,86vw)] translate-x-full flex-col bg-navy-800 shadow-2xl transition-transform duration-300 ease-out motion-reduce:transition-none"
    role="dialog"
    aria-modal="true"
    aria-label={t('nav.primary')}
  >
    <div class="flex h-[var(--header-h)] flex-none items-center justify-between gap-3 border-b border-white/10 px-5">
      <span class="font-display text-[0.6875rem] font-bold uppercase tracking-[0.2em] text-white/45">
        {t('nav.menu')}
      </span>
      <button
        type="button"
        class="js-nav-close -mr-2 inline-flex h-11 w-11 items-center justify-center text-white/70 transition-colors hover:text-white"
        data-nav-close
        aria-label={t('nav.close')}
      >
        <Icon name="close" size={24} />
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto overscroll-contain px-5 py-2" aria-label={t('nav.primary')}>
      <ul class="divide-y divide-white/10">
        {nav.map((item) => (
          <li>
            <div class="flex items-center">
              <a
                href={localizedPath(item.key, locale)}
                class:list={[
                  'flex flex-1 items-center gap-3 py-3.5 font-display text-[0.9375rem] font-bold uppercase tracking-[0.06em] transition-colors',
                  isActive(item.key) ? 'text-brand-ink' : 'text-white hover:text-white',
                ]}
                aria-current={isActive(item.key) ? 'page' : undefined}
              >
                <Icon
                  name={item.icon}
                  size={19}
                  class={isActive(item.key) ? 'flex-none text-brand-ink' : 'flex-none text-white/45'}
                />
                {item.label}
              </a>
              {item.children && (
                <button
                  type="button"
                  class="js-submenu -mr-2 inline-flex h-11 w-11 flex-none items-center justify-center text-white/50 transition-transform hover:text-white"
                  aria-expanded="false"
                  aria-label={item.label}
                >
                  <Icon name="chevron-down" size={20} />
                </button>
              )}
            </div>
            {item.children && (
              <ul class="js-submenu-panel hidden pb-3 pl-8">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="flex items-center gap-2.5 py-2 text-sm text-white/65 transition-colors hover:text-white"
                    >
                      <Icon name={child.icon} size={15} class="flex-none text-white/30" />
                      <span class="flex-1">{child.label}</span>
                      {child.note && (
                        <span class="flex-none font-display text-[0.5625rem] font-bold uppercase tracking-wider text-white/40">
                          {child.note}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex-none border-t border-white/10 px-5 py-4">
      <a href={wa} class="btn btn-whatsapp btn-block" rel="noopener" target="_blank">
        <Icon name="whatsapp" size={18} filled />
        {t('cta.whatsapp')}
      </a>
    </div>
  </aside>
</div>

<script nonce={nonce} is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var shell = document.getElementById('mobile-nav');
    var header = document.getElementById('site-header');
    if (!toggle || !shell) return;

    var backdrop = shell.querySelector('.js-nav-backdrop');
    var panel = shell.querySelector('.js-nav-panel');
    var closeButton = shell.querySelector('.js-nav-close');
    var open = false;
    var settle;

    // Selektor unsur yang dapat menerima fokus, dipakai untuk menahan fokus
    // di dalam laci selama laci terbuka.
    var FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

    function setOpen(next) {
      if (next === open) return;
      open = next;

      window.clearTimeout(settle);
      toggle.setAttribute('aria-expanded', String(open));
      shell.setAttribute('aria-hidden', String(!open));
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) {
        // Lepas `invisible` lebih dulu, lalu geser panel pada bingkai
        // berikutnya — bila keduanya berubah dalam satu bingkai, peramban
        // tidak punya keadaan awal untuk dianimasikan.
        shell.classList.remove('invisible');
        window.requestAnimationFrame(function () {
          if (backdrop) backdrop.classList.replace('opacity-0', 'opacity-100');
          if (panel) panel.classList.remove('translate-x-full');
        });
        if (closeButton) closeButton.focus();
      } else {
        if (backdrop) backdrop.classList.replace('opacity-100', 'opacity-0');
        if (panel) panel.classList.add('translate-x-full');
        // Sembunyikan sepenuhnya baru setelah transisi selesai, supaya laci
        // tidak lenyap begitu saja di tengah animasi.
        settle = window.setTimeout(function () {
          shell.classList.add('invisible');
        }, 300);
      }
    }

    toggle.addEventListener('click', function () {
      setOpen(!open);
    });

    // Menutup lewat tombol silang, latar gelap, dan setiap tautan di dalam
    // laci — semuanya ditangani satu kali di tingkat laci.
    shell.addEventListener('click', function (event) {
      var target = event.target;
      if (!target.closest) return;
      if (target.closest('[data-nav-close]') || target.closest('a[href]')) {
        setOpen(false);
        if (target.closest('[data-nav-close]')) toggle.focus();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (!open) return;

      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }

      if (event.key !== 'Tab' || !panel) return;

      // Tahan fokus di dalam laci: tanpa ini, Tab akan berjalan ke tautan di
      // balik latar gelap yang tidak terlihat oleh pembaca.
      var items = Array.prototype.filter.call(
        panel.querySelectorAll(FOCUSABLE),
        function (node) { return node.offsetParent !== null; }
      );
      if (!items.length) return;

      var first = items[0];
      var last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Tutup laci ketika layar melebar melewati titik henti desktop, jika tidak
    // `overflow: hidden` akan tertinggal menempel pada <body>.
    var wide = window.matchMedia('(min-width: 1280px)');
    wide.addEventListener('change', function (event) {
      if (event.matches) setOpen(false);
    });

    shell.querySelectorAll('.js-submenu').forEach(function (button) {
      button.addEventListener('click', function () {
        var list = button.closest('li');
        var sub = list && list.querySelector('.js-submenu-panel');
        if (!sub) return;
        var expanded = sub.classList.contains('hidden');
        sub.classList.toggle('hidden', !expanded);
        button.setAttribute('aria-expanded', String(expanded));
        button.style.transform = expanded ? 'rotate(180deg)' : '';
      });
    });

    if (header) {
      var onScroll = function () {
        header.classList.toggle('shadow-xl', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  })();
</script>
