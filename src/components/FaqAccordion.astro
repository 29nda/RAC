---
import type { Locale } from '../i18n/config';
import { pick } from '../i18n/ui';
import type { Faq } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  faqs: Faq[];
  /** Opens the first entry, which helps a crawler see answer text immediately. */
  openFirst?: boolean;
}

const { locale, faqs, openFirst = true } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {faqs.map((faq, index) => (
    <details
      class="group reveal"
      name="faq"
      open={openFirst && index === 0}
      id={faq.id}
    >
      <summary
        class="flex cursor-pointer list-none items-start justify-between gap-5 py-5 text-left marker:hidden [&::-webkit-details-marker]:hidden"
      >
        <h3 class="text-base font-semibold leading-snug text-ink sm:text-[1.0625rem]">
          {pick(faq.question, locale)}
        </h3>
        <span class="mt-0.5 flex-none text-brand-ink transition-transform duration-300 group-open:rotate-45">
          <Icon name="plus" size={22} />
        </span>
      </summary>
      <div class="pb-6 pr-10">
        <p class="text-[0.9375rem] leading-relaxed text-muted">{pick(faq.answer, locale)}</p>
      </div>
    </details>
  ))}
</div>
