---
import type { Locale } from '../i18n/config';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  /** Must include a display utility — the base classes deliberately omit one. */
  class?: string;
}

const { locale, class: className = '' } = Astro.props;
const nonce = Astro.locals.cspNonce;

const label = locale === 'id'
  ? 'Ganti tema terang atau gelap'
  : 'Switch between light and dark theme';
---

{/* No display utility in the base list: the caller supplies it. Putting
    `inline-flex` here would collide with a caller's `hidden`, and which one
    wins depends on their order in the generated stylesheet rather than on the
    order they appear in the attribute. */}
<button
  type="button"
  data-theme-toggle
  class:list={[
    'items-center justify-center border border-white/20 text-white/70 transition-colors hover:border-white/40 hover:text-white',
    className,
  ]}
  aria-label={label}
  title={label}
>
  {/* The moon shows by default: with no JavaScript the page stays light, and
      "switch to dark" is then the honest affordance. */}
  <Icon name="moon" size={17} class="js-to-dark" />
  <Icon name="sun" size={17} class="js-to-light hidden" />
</button>

<script nonce={nonce} is:inline>
  (function () {
    // This component renders more than once (desktop bar and mobile drawer),
    // so its script is emitted more than once too. Guard against re-running.
    if (window.__racThemeBound) return;
    window.__racThemeBound = true;

    var STORAGE_KEY = 'rac-theme';

    function stored() {
      try { return window.localStorage.getItem(STORAGE_KEY); } catch (error) { return null; }
    }

    function active() {
      var set = document.documentElement.getAttribute('data-theme');
      if (set === 'dark' || set === 'light') return set;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function paint(theme) {
      document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
        var toDark = button.querySelector('.js-to-dark');
        var toLight = button.querySelector('.js-to-light');
        // Show the icon for the theme the reader would move *to*.
        if (toDark) toDark.classList.toggle('hidden', theme === 'dark');
        if (toLight) toLight.classList.toggle('hidden', theme !== 'dark');
        button.setAttribute('aria-pressed', String(theme === 'dark'));
      });
    }

    // Delegated, because an inline script runs while the document is still
    // parsing: binding each button directly would miss every instance that
    // appears later in the markup.
    document.addEventListener('click', function (event) {
      var button = event.target.closest && event.target.closest('[data-theme-toggle]');
      if (!button) return;

      var next = active() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        window.localStorage.setItem(STORAGE_KEY, next);
      } catch (error) {
        // Private browsing can refuse storage; the choice then lasts for this
        // page view only, which beats failing the click outright.
      }
      paint(next);
    });

    function sync() { paint(active()); }

    // Paint once the whole document exists, so buttons further down are found.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', sync);
    } else {
      sync();
    }

    // Keep following the system for as long as the reader has chosen nothing.
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
      if (!stored()) sync();
    });
  })();
</script>
