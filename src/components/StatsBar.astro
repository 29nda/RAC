---
import type { Locale } from '../i18n/config';
import { pick } from '../i18n/ui';
import type { StatItem } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  stats: StatItem[];
  floating?: boolean;
}

const { locale, stats, floating = false } = Astro.props;
---

<div
  class:list={[
    'on-navy grid grid-cols-2 border border-white/10 bg-navy-900/90 backdrop-blur lg:grid-cols-4',
    floating && 'shadow-[0_24px_60px_-30px_rgba(5,11,19,0.9)]',
  ]}
>
  {stats.map((stat) => (
    <div class="border-b border-r border-white/10 p-6 text-center last:border-r-0 lg:border-b-0 lg:p-7 [&:nth-child(2)]:border-r-0 lg:[&:nth-child(2)]:border-r">
      <Icon name={(stat.icon || 'users') as 'users'} size={26} class="mx-auto text-brand-ink" />
      <p class="mt-3 font-display text-2xl font-bold text-white lg:text-3xl">{stat.value}</p>
      <p class="mt-1 text-[0.75rem] leading-snug text-white/55 lg:text-[0.8125rem]">
        {pick(stat.label, locale)}
      </p>
    </div>
  ))}
</div>
