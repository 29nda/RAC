---
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/config';
import { useTranslations, pick } from '../i18n/ui';
import type { SiteContent } from '../lib/types';
import { getPage, publishedCourses, publishedFaqs, upcomingSchedule } from '../lib/content';
import { getSiteUrl } from '../lib/env';
import { graph, breadcrumbSchema, itemListSchema, courseSchema, faqSchema } from '../lib/seo';

import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CourseCard from '../components/CourseCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';

interface Props {
  locale: Locale;
  content: SiteContent;
}

const { locale, content } = Astro.props;
const t = useTranslations(locale);
const s = content.settings;
const page = getPage(content, 'training');
const site = getSiteUrl(Astro.locals);

const courses = publishedCourses(content);
const sessions = upcomingSchedule(content);
const faqs = publishedFaqs(content).filter((f) => f.group === 'training').slice(0, 5);

const trail = [
  { name: t('nav.home'), path: localizedPath('home', locale) },
  { name: t('nav.training'), path: localizedPath('training', locale) },
];

const jsonLd = graph([
  breadcrumbSchema(site, trail),
  itemListSchema(site, locale === 'id' ? 'Program Pelatihan RAC' : 'RAC Training Programmes',
    courses.map((course) => ({
      name: pick(course.title, locale),
      description: pick(course.summary, locale),
      path: localizedPath('training', locale, course.slug),
    }))),
  ...courses.map((course) => courseSchema(site, course, locale, s, sessions)),
  faqSchema(faqs, locale),
]);
---

<SiteLayout
  locale={locale}
  routeKey="training"
  content={content}
  title={pick(page.metaTitle, locale)}
  description={pick(page.metaDescription, locale)}
  jsonLd={jsonLd}
  whatsappSubject={locale === 'id' ? 'program pelatihan RAC' : 'RAC training programmes'}
>
  <PageHero
    locale={locale}
    eyebrow={pick(page.heroEyebrow, locale)}
    title={pick(page.heroTitle, locale)}
    subtitle={pick(page.heroSubtitle, locale)}
    trail={trail}
  />

  <section class="py-16 lg:py-20">
    <div class="container-rac">
      <p class="max-w-3xl text-base leading-relaxed text-steel-400">{pick(page.intro, locale)}</p>

      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {courses.map((course) => <CourseCard locale={locale} course={course} />)}
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href={localizedPath('schedule', locale)} class="btn btn-primary">
          {t('nav.schedule')}
          <Icon name="calendar" size={16} />
        </a>
        <a href={localizedPath('certification', locale)} class="btn btn-ghost-dark">
          {t('nav.certification')}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="bg-steel-50 py-16 lg:py-20">
      <div class="container-rac">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-5">
            <SectionHeading eyebrow="FAQ" title={t('section.faqTitle')} />
          </div>
          <div class="lg:col-span-7">
            <FaqAccordion locale={locale} faqs={faqs} />
          </div>
        </div>
      </div>
    </section>
  )}

  <CtaBand
    locale={locale}
    settings={s}
    eyebrow={locale === 'id' ? 'Belum yakin level mana?' : 'Not sure which level?'}
    title={locale === 'id'
      ? 'Kami Bantu Petakan\nJalur Sertifikasi Anda.'
      : 'We Will Help You Map\nYour Certification Path.'}
    subject={locale === 'id' ? 'pemilihan level pelatihan' : 'choosing a training level'}
  />
</SiteLayout>
